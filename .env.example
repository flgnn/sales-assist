# Salin menjadi .env — jangan pernah commit .env (sudah ada di .gitignore).
PORT=3001
# Wajib di production: string acak panjang (mis. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=
GOOGLE_CLIENT_ID=

# CORS whitelist (pisahkan koma). Kosong = hanya same-origin.
CORS_ORIGINS=

# Mesin rekomendasi: hybrid (default) | baseline (AI Matcher versi KP)
RECOMMENDER_ENGINE=hybrid
# Wilayah yang diprioritaskan pada produk Datin (regex, tanpa huruf besar/kecil)
PREFERRED_REGION=jabar|jawa

# Email penawaran. Tanpa SMTP_* sistem berjalan di MODE UJI (email disimulasikan, tidak terkirim).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
QUOTATION_VALID_DAYS=30

# Pengingat email harian untuk tindak lanjut pipeline
REMINDER_EMAIL=0
REMINDER_INTERVAL_MIN=60

# Pembatasan laju
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=20
# Isi 1 bila di belakang reverse proxy (nginx/Caddy) agar IP klien terbaca benar
TRUST_PROXY=
